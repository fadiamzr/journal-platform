# Copy this file to apps/web/.env.local and fill in real values.
# Never commit .env.local — it is in .gitignore.
# NEXT_PUBLIC_* variables are embedded in the browser bundle — do NOT put secrets here.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project URL (e.g. https://<ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable (anon) key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Backend API ───────────────────────────────────────────────────────────────
# Base URL of the FastAPI backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
